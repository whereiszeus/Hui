# 1. Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# 2. MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# 3. MongoDB Database Name
DATABASE_NAME=biolink_guardian_bot

# 4. Bot Owner & Audit Log Group IDs
OWNER_ID=8677818347
LOG_GROUP_ID=-1001234567890

# 5. UI Banner & Support Links
SUPPORT_CHANNEL_URL=https://t.me/Telegram
BANNER_URL=https://telegra.ph/file/5b50d1e9a4b7d9e38a85e.jpg
BANNER_PATH=banner.jpg

# 6. Default Moderation Settings (delete | warn | mute | ban)
DEFAULT_ACTION=delete
MAX_WARNINGS=3
MUTE_DURATION_MINUTES=60
WARN_DELETE_SECONDS=15
BIO_CACHE_TTL_SECONDS=120

# 7. Render Web Service Health Check Port
PORT=8080
